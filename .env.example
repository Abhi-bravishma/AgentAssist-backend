# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/agent_assist
DB_USER=root
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_32_char_minimum_secret_key_here
JWT_EXPIRATION_MS=86400000

# AI Provider Selection: "openai" or "ollama"
AI_PROVIDER=openai

# OpenAI Configuration (required if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (required if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# CORS Configuration (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Server Port (optional, default: 8080)
SERVER_PORT=8080
